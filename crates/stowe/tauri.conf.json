{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stowe",
  "version": "0.5.0",
  "identifier": "com.stowe.dev",
  "build": {
    "frontendDist": "web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd web && bun run dev",
    "beforeBuildCommand": "cd web && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Stowe",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Transparent",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ]
  }
}
